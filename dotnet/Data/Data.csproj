<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the pure sources in place (no copy). No Unity references are available here:
       any UnityEngine usage in Data fails this build. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Data</AssemblyName>
    <RootNamespace>Game.Data</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GameSources)Data/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- D-11: same Json.NET version bundled by Unity's com.unity.nuget.newtonsoft-json 3.2.1. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>
