<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the pure sources in place (no copy). No Unity references are available here:
       any UnityEngine usage in Match.AI fails this build. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Match.AI</AssemblyName>
    <RootNamespace>Game.Match.AI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GameSources)Match.AI/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="../Data/Data.csproj" />
    <ProjectReference Include="../Rules/Rules.csproj" />
    <ProjectReference Include="../Match/Match.csproj" />
  </ItemGroup>
</Project>
