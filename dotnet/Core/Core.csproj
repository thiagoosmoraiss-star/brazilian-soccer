<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the pure sources in place (no copy). No Unity references are available here:
       any UnityEngine usage in Core fails this build. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Core</AssemblyName>
    <RootNamespace>Game.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GameSources)Core/**/*.cs" />
  </ItemGroup>
</Project>
