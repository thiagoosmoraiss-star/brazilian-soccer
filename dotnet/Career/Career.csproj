<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the pure sources in place (no copy). No Unity references are available here:
       any UnityEngine usage in Career fails this build. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Career</AssemblyName>
    <RootNamespace>Game.Career</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GameSources)Career/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="../Data/Data.csproj" />
    <ProjectReference Include="../Rules/Rules.csproj" />
    <ProjectReference Include="../Match/Match.csproj" />
    <ProjectReference Include="../Simulation/Simulation.csproj" />
  </ItemGroup>
</Project>
