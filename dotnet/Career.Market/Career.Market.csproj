<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the pure sources in place (no copy). No Unity references are available here:
       any UnityEngine usage in Career.Market fails this build. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Career.Market</AssemblyName>
    <RootNamespace>Game.Career.Market</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GameSources)Career.Market/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="../Data/Data.csproj" />
    <ProjectReference Include="../Rules/Rules.csproj" />
    <ProjectReference Include="../Career/Career.csproj" />
  </ItemGroup>
</Project>
