<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool (A7a): the vertical slice's headless report — strong × weak batches and attribute sensitivity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MatchReport</AssemblyName>
    <RootNamespace>Game.Tools.MatchReport</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- C2: the calibration batch shared with Tests/Simulation (same matchups in both engines). -->
    <Compile Include="$(GameSources)Tests/Simulation/Calibration.cs" Link="Calibration.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Match.AI/Match.AI.csproj" />
    <ProjectReference Include="../Simulation/Simulation.csproj" />
    <ProjectReference Include="../Career/Career.csproj" />
  </ItemGroup>
</Project>
