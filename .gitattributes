# Text: normalized line endings (code, data, docs stay in regular Git - D-06)
* text=auto
*.cs      text eol=lf diff=csharp
*.csproj  text eol=lf
*.sln     text eol=crlf
*.props   text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.asmdef  text eol=lf
*.asmref  text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
# Unity YAML assets (Force Text serialization)
*.meta    text eol=lf
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.mat     text eol=lf
*.anim    text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.playable text eol=lf
*.mask    text eol=lf
*.uxml    text eol=lf
*.uss     text eol=lf
*.shader  text eol=lf
*.hlsl    text eol=lf

# ---- Git LFS: binary/heavy files (D-06: models, textures, audio, video, fonts) ----
# 3D models / animation sources
*.fbx  filter=lfs diff=lfs merge=lfs -text
